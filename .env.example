# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Tajikistan SMS & OTP Gateway configuration (e.g. O Mobile, Babilon, Tcell)
SMS_PROVIDER_API_KEY="your_tajik_sms_provider_key"
SMS_SENDER_NAME="ZUD"

# Tajikistan Payment Gateway credentials (Korti Milli, DC Next, Alif Mobi, Spitamen)
PAYMENT_GATEWAY_MERCHANT_ID="zud_dushanbe_merchant"
PAYMENT_GATEWAY_SECRET_KEY="your_payment_secret"
PAYMENT_GATEWAY_TEST_MODE="true"

# Maps API configuration (Google Maps / OpenStreetMap)
MAPS_API_KEY="your_maps_api_key"
